{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.38.33.27573",
      "templateHash": "4369605571968573686"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "metadata": {
        "description": "Location for all resources (e.g., East US, West Europe)"
      }
    },
    "webAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the web app (must be globally unique, e.g., my-vaali-mcp-server)"
      }
    },
    "appServicePlanName": {
      "type": "string",
      "metadata": {
        "description": "Name of the App Service plan (e.g., my-vaali-mcp-server-plan)"
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": [
        "B1",
        "B2",
        "S1",
        "S2"
      ],
      "metadata": {
        "description": "App Service plan pricing tier - B1 recommended (lowest cost), B2 (2x B1), S1+ (production features)"
      }
    },
    "skuCapacity": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "maxValue": 3,
      "metadata": {
        "description": "Number of instances (1 recommended for most use cases)"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "[parameters('appServicePlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('skuName')]",
        "tier": "[if(or(equals(parameters('skuName'), 'B1'), equals(parameters('skuName'), 'B2')), 'Basic', 'Standard')]",
        "capacity": "[parameters('skuCapacity')]"
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[parameters('webAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
        "siteConfig": {
          "linuxFxVersion": "NODE|18-lts",
          "appCommandLine": "npm run start:sse",
          "appSettings": [
            {
              "name": "NODE_ENV",
              "value": "production"
            },
            {
              "name": "TRANSPORT",
              "value": "sse"
            },
            {
              "name": "PORT",
              "value": "3001"
            },
            {
              "name": "WEBSITE_NODE_DEFAULT_VERSION",
              "value": "18-lts"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            }
          ],
          "cors": {
            "allowedOrigins": [
              "*"
            ],
            "supportCredentials": false
          }
        },
        "httpsOnly": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]"
      ]
    }
  ],
  "outputs": {
    "webAppUrl": {
      "type": "string",
      "metadata": {
        "description": "URL of the deployed web application"
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2023-01-01').defaultHostName)]"
    },
    "webAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the created web app"
      },
      "value": "[parameters('webAppName')]"
    },
    "sseEndpoint": {
      "type": "string",
      "metadata": {
        "description": "SSE endpoint for MCP clients"
      },
      "value": "[format('https://{0}/sse', reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2023-01-01').defaultHostName)]"
    },
    "resourceGroupName": {
      "type": "string",
      "metadata": {
        "description": "Resource group name"
      },
      "value": "[resourceGroup().name]"
    },
    "relativeCost": {
      "type": "string",
      "metadata": {
        "description": "Relative cost comparison - B1: Base cost (recommended), B2: 2x B1, S1+: ~5x B1 with production features"
      },
      "value": "[if(equals(parameters('skuName'), 'B1'), 'Base cost - Most economical choice', if(equals(parameters('skuName'), 'B2'), '2x base cost - Better performance', '~5x base cost - Production features included'))]"
    },
    "performanceGuide": {
      "type": "string",
      "metadata": {
        "description": "Performance and feature guide"
      },
      "value": "[if(equals(parameters('skuName'), 'B1'), '10-20 concurrent connections, perfect for demos', if(equals(parameters('skuName'), 'B2'), '20-50 concurrent connections, good for teams', '50+ concurrent connections with staging slots and backups'))]"
    }
  }
}